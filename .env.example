# 至少配置一个模型 API Key。不要把真实密钥提交到 Git。
OPENAI_API_KEY=
TAVILY_API_KEY=

# GPT Researcher 配置
FAST_LLM=openai:gpt-4.1-mini
SMART_LLM=openai:gpt-4.1
STRATEGIC_LLM=openai:gpt-4.1
RETRIEVER=tavily
LANGUAGE=chinese
TOTAL_WORDS=1800
MAX_SEARCH_RESULTS_PER_QUERY=5

# 可选：把岗位 JD、个人简历等 PDF/TXT/MD 放入 data/ 后启用混合检索
DOC_PATH=./data
REPORT_SOURCE=web

# 商业部署建议设置。留空表示本地开发无需登录。
APP_ACCESS_TOKEN=
RATE_LIMIT_PER_MINUTE=60
DATABASE_PATH=./var/job_research.db

# 每个进程最多同时执行的任务数；真实调研超时时长（秒）
MAX_ACTIVE_TASKS=2
RESEARCH_TIMEOUT_SECONDS=900
# HTTPS 部署时设为 true
COOKIE_SECURE=false
